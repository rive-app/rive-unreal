{
    "FileVersion": 3,
    "Version": {{ ReleaseCount | int + 1 }},
    "VersionName": "{{ VersionName }}",
    {% if UnrealEngineVersion is defined %}
    "EngineVersion": "{{ UnrealEngineVersion }}",
    {% endif %}
    {% if FAB_URL is defined %}
    "FabURL":"{{ FAB_URL }}",
    {% endif %}
    "FriendlyName": "Rive",
    "Description": "An Unreal Engine runtime library for Rive.",
    "Category": "Rive",
    "CreatedBy": "Rive, Inc.",
    "CreatedByURL": "https://rive.app/",
    "DocsURL": "https://rive.app/docs/getting-started/introduction",
    "MarketplaceURL": "",
    "SupportURL": "https://community.rive.app/",
    "CanContainContent": true,
    "IsBetaVersion": true,
    "IsExperimentalVersion": true,
    "Installed": true,
    "Modules": [
		{
			"Name": "Rive",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
			{% if RuntimeModulePlatforms is defined %}
                           {% for platform in RuntimeModulePlatforms if platform %}
                               {% if platform %}
                                 "{{ platform }}"{% if not loop.last %},
				 {% endif %}
                               {% endif %}
                           {% endfor %}
                        {% endif %}
			],
			"BlacklistTargets": [ "Server" ]
		},
		{
			"Name": "RiveShaders",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [
			{% if RuntimeModulePlatforms is defined %}
                           {% for platform in RuntimeModulePlatforms if platform %}
                               {% if platform %}
                                 "{{ platform }}"{% if not loop.last %},
				 {% endif %}
                               {% endif %}
                           {% endfor %}
                        {% endif %}
                        ],
                        "BlacklistTargets": [ "Server" ]
		},
		{
			"Name": "RiveStats",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [
			{% if RuntimeModulePlatforms is defined %}
                           {% for platform in RuntimeModulePlatforms if platform %}
                               {% if platform %}
                                 "{{ platform }}"{% if not loop.last %},
				 {% endif %}
                               {% endif %}
                           {% endfor %}
                        {% endif %}
			],
                        "BlacklistTargets": [ "Server" ]
		},
		{
			"Name": "RiveRenderer",
			"Type": "RuntimeNoCommandlet",
			"LoadingPhase": "PreDefault",
			"PlatformAllowList": [
			{% if RuntimeModulePlatforms is defined %}
                           {% for platform in RuntimeModulePlatforms if platform %}
                               {% if platform %}
                                 "{{ platform }}"{% if not loop.last %},
				 {% endif %}
                               {% endif %}
                           {% endfor %}
                        {% endif %}
			],
			"BlacklistTargets": [ "Server" ]
		},
		{
			"Name": "RiveEditor",
			"Type": "Editor",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
			{% if EditorModulePlatforms is defined %}
                           {% for platform in EditorModulePlatforms if platform %}
                               {% if platform %}
                                 "{{ platform }}"{% if not loop.last %},
				 {% endif %}
                               {% endif %}
                           {% endfor %}
                        {% endif %}
			]
		},
		{
			"Name": "RiveEditorNodes",
			"Type": "UncookedOnly",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
			{% if EditorModulePlatforms is defined %}
                           {% for platform in EditorModulePlatforms if platform %}
                               {% if platform %}
                                 "{{ platform }}"{% if not loop.last %},
				 {% endif %}
                               {% endif %}
                           {% endfor %}
                        {% endif %}
			]
		}
	],
	"Plugins": [
		{
			"Name": "EditorScriptingUtilities",
			"Enabled": true
		}
	]
}
